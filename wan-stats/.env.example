# Copy this file to .env and fill in the key. Git ignores .env.
#   cp .env.example .env && chmod 600 .env

# A Meraki Dashboard API key. A read-only key is enough: WAN stats never changes a network.
MERAKI_API_KEY=

# Optional. Collect from these organizations only (IDs, separated by commas).
# The default is every organization the key can see.
# MERAKI_ORG_ID=

# Optional. Where the readings are kept. The default is a SQLite file beside the scripts.
# WAN_STATS_DB=sqlite:///wan-stats.sqlite
# WAN_STATS_DB=postgresql://user:password@db-host/wan_stats
# WAN_STATS_DB=mongodb://user:password@db-host/wan_stats

# Optional. Delete readings older than this many days. The default keeps everything.
# WAN_STATS_KEEP_DAYS=730
